# Copy file này thành .env rồi điền giá trị:  cp .example.env .env
# KHÔNG commit file .env (đã có trong .gitignore).

# ───────────── App ─────────────
NODE_ENV=development            # development | production | test
PORT=5000
HOST=localhost
APP_PREFIX=/api                 # Swagger ở http://HOST:PORT/api
APP_NAME=home_decor

# Địa chỉ frontend, dùng cho CORS, chống CSRF (kiểm tra Origin) và link trong email.
# Nhiều địa chỉ thì cách nhau bằng dấu phẩy.
FE_URL=http://localhost:3000

# SameSite của cookie đăng nhập: lax | strict | none. Giữ "lax" nếu FE và API cùng domain gốc
# (vd shop.com và api.shop.com, hoặc localhost khác port). Chỉ dùng "none" khi FE và API khác domain gốc.
COOKIE_SAME_SITE=lax

# ───────────── Database (MongoDB Atlas) ─────────────
# PHẢI có tên database sau dấu "/" (ở đây là home_decor). Password có ký tự đặc biệt thì URL-encode.
DATABASE_URL="mongodb+srv://<user>:<password>@<cluster>.xxxxx.mongodb.net/home_decor?retryWrites=true&w=majority"

# ───────────── JWT ─────────────
# Bắt buộc. Hai secret PHẢI khác nhau, production cần dài ít nhất 32 ký tự. Tạo chuỗi ngẫu nhiên:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
JWT_REFRESH_SECRET=

# ───────────── Cloudinary (upload ảnh) ─────────────
CLOUDINARY_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ───────────── Mail (nodemailer, SMTP) ─────────────
# Bỏ trống MAIL_HOST: email không được gửi; ở development nội dung (vd link reset password) được in ra log.
# Ví dụ Gmail: MAIL_HOST=smtp.gmail.com, MAIL_PORT=587, MAIL_PASS là App Password (không phải mật khẩu Gmail).
MAIL_HOST=
MAIL_PORT=587                   # 465 = SSL, 587 = STARTTLS
MAIL_USER=
MAIL_PASS=
MAIL_FROM="Home Decor <no-reply@example.com>"   # bỏ trống thì dùng MAIL_USER

# ───────────── Đơn hàng ─────────────
ORDER_UNPAID_TIMEOUT_MINUTES=30 # đơn VNPay / MoMo chưa thanh toán quá thời gian này thì tự hủy

# ───────────── Thanh toán (giai đoạn 4, chưa dùng) ─────────────
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
VNPAY_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_RETURN_URL=http://localhost:3000/payment/result

MOMO_PARTNER_CODE=
MOMO_ACCESS_KEY=
MOMO_SECRET_KEY=
MOMO_ENDPOINT=https://test-payment.momo.vn/v2/gateway/api/create

# ───────────── Rate limit / cache / upload ─────────────
THROTTLE_TTL=60000              # cửa sổ thời gian (ms)
THROTTLE_LIMIT=100              # số request tối đa mỗi IP trong một cửa sổ
CACHE_INTERNAL_TTL=30000        # ms
MULTER_DESTINATION_FILE=./uploads

# ───────────── Seed (npm run db:seed) ─────────────
SEED_ADMIN_EMAIL=admin@homedecor.local
SEED_ADMIN_PASSWORD=            # bỏ trống thì sinh ngẫu nhiên và in ra một lần
