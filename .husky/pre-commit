staged=$(git diff --cached --name-only)

if echo "$staged" | grep -q '^backend/'; then
  echo "> backend: lint, format, test"
  (cd backend && npm run lint && npm run format && npm run test) || exit 1
fi

if echo "$staged" | grep -q '^frontend/'; then
  echo "> frontend: lint, typecheck, format:check, test"
  (cd frontend && npm run check) || exit 1
fi
